#!/usr/bin/env bash
# =============================================================================
# test_hooks.sh.proposed
# proposed hook scripts の動作テスト
#
# 実行方法: bash .claude/hooks/test_hooks.sh.proposed
#
# 全テスト PASS を確認してから proposed → 正規ファイルへのコピーを行うこと
# =============================================================================

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"
HOOKS_DIR="${REPO_ROOT}/.claude/hooks"
PREFLIGHT="${HOOKS_DIR}/preflight_session.sh.proposed"
POST_TOOL="${HOOKS_DIR}/post_tool_use.sh.proposed"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

PASS=0
FAIL=0

# =============================================================================
# ユーティリティ
# =============================================================================

run_test() {
  local test_name="$1"
  local expected_exit="$2"
  shift 2
  local actual_exit=0

  "$@" >/dev/null 2>&1 || actual_exit=$?

  if [ "${actual_exit}" -eq "${expected_exit}" ]; then
    echo -e "  ${GREEN}PASS${NC} [${test_name}] (exit ${actual_exit})"
    PASS=$((PASS + 1))
  else
    echo -e "  ${RED}FAIL${NC} [${test_name}] expected exit ${expected_exit}, got ${actual_exit}"
    FAIL=$((FAIL + 1))
  fi
}

# =============================================================================
# bash 構文チェック (必須: 実際に実行する前に確認)
# =============================================================================

echo ""
echo "======================================"
echo " Hook Script 構文チェック"
echo "======================================"

run_test "preflight 構文チェック" 0 bash -n "${PREFLIGHT}"
run_test "post_tool_use 構文チェック" 0 bash -n "${POST_TOOL}"

# =============================================================================
# preflight_session.sh.proposed テスト
# =============================================================================

echo ""
echo "======================================"
echo " preflight_session.sh.proposed テスト"
echo "======================================"

# テスト 1: 正常系 (現在の環境で通過するか)
echo ""
echo "--- Test 1: 正常系 ---"
CLAUDE_TOOL_NAME="Read" CLAUDE_SESSION_ID="test-session" \
  bash "${PREFLIGHT}" >/dev/null 2>&1
PREFLIGHT_NORMAL_EXIT=$?
if [ "${PREFLIGHT_NORMAL_EXIT}" -eq 0 ] || [ "${PREFLIGHT_NORMAL_EXIT}" -eq 1 ]; then
  echo -e "  ${GREEN}PASS${NC} [正常系] exit ${PREFLIGHT_NORMAL_EXIT} (0=通過 / 1=警告あり)"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [正常系] 予期しない exit ${PREFLIGHT_NORMAL_EXIT}"
  FAIL=$((FAIL + 1))
fi

# テスト 2: sealed stash 件数チェック (現環境)
echo ""
echo "--- Test 2: sealed stash 件数確認 ---"
STASH_COUNT="$(git stash list 2>/dev/null | wc -l | tr -d ' ')"
if [ "${STASH_COUNT}" -eq 8 ]; then
  echo -e "  ${GREEN}PASS${NC} [stash 件数] ${STASH_COUNT} 件 (期待値: 8)"
  PASS=$((PASS + 1))
elif [ "${STASH_COUNT}" -gt 8 ]; then
  echo -e "  ${YELLOW}WARN${NC} [stash 件数] ${STASH_COUNT} 件 (基準: 8、新規 stash あり)"
  PASS=$((PASS + 1))  # 8 より多いのは hook がブロックしないので PASS
else
  echo -e "  ${RED}FAIL${NC} [stash 件数] ${STASH_COUNT} 件 (期待値: 8、hook が block するはず)"
  FAIL=$((FAIL + 1))
fi

# テスト 3: forbidden_changes — Edit ツールで settings.json を編集しようとした場合
echo ""
echo "--- Test 3: forbidden_changes 突合 (.claude/settings.json) ---"
FORBIDDEN_INPUT='{"file_path": ".claude/settings.json", "old_string": "plan", "new_string": "bypassPermissions"}'
BLOCK_EXIT=0
echo "${FORBIDDEN_INPUT}" | CLAUDE_TOOL_NAME="Edit" bash "${PREFLIGHT}" >/dev/null 2>&1 || BLOCK_EXIT=$?
if [ "${BLOCK_EXIT}" -eq 2 ]; then
  echo -e "  ${GREEN}PASS${NC} [forbidden_changes] settings.json 編集が block されました (exit 2)"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [forbidden_changes] expected exit 2, got ${BLOCK_EXIT}"
  FAIL=$((FAIL + 1))
fi

# テスト 4: forbidden_changes — Bash で vision-and-principles.md を編集しようとした場合
echo ""
echo "--- Test 4: forbidden_changes 突合 (docs/strategy/vision-and-principles.md) ---"
FORBIDDEN_BASH='{"command": "echo test >> docs/strategy/vision-and-principles.md"}'
BLOCK_EXIT2=0
echo "${FORBIDDEN_BASH}" | CLAUDE_TOOL_NAME="Bash" bash "${PREFLIGHT}" >/dev/null 2>&1 || BLOCK_EXIT2=$?
if [ "${BLOCK_EXIT2}" -eq 2 ]; then
  echo -e "  ${GREEN}PASS${NC} [forbidden_changes] vision-and-principles.md 操作が block されました (exit 2)"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [forbidden_changes] expected exit 2, got ${BLOCK_EXIT2}"
  FAIL=$((FAIL + 1))
fi

# テスト 5: 異常系シミュレーション — main branch での git push (シミュレーション)
echo ""
echo "--- Test 5: main branch git push シミュレーション ---"
echo "(このテストは実際に branch を変更しません — 環境変数で代替)"
PUSH_INPUT='{"command": "git push origin main"}'
# 現在 main でないので直接テスト不可。スクリプトを読んで検証ロジックを確認
if grep -q 'git push origin main\|git.*push\|git.*merge\|git.*reset' "${PREFLIGHT}"; then
  echo -e "  ${GREEN}PASS${NC} [git push 検出ロジック] preflight に push/merge/reset 検出コードあり"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [git push 検出ロジック] preflight に検出コードが見つかりません"
  FAIL=$((FAIL + 1))
fi

# =============================================================================
# post_tool_use.sh.proposed テスト
# =============================================================================

echo ""
echo "======================================"
echo " post_tool_use.sh.proposed テスト"
echo "======================================"

# テスト 6: 正常系
echo ""
echo "--- Test 6: 正常系 ---"
POST_EXIT=0
CLAUDE_TOOL_NAME="Read" bash "${POST_TOOL}" >/dev/null 2>&1 || POST_EXIT=$?
if [ "${POST_EXIT}" -eq 0 ] || [ "${POST_EXIT}" -eq 1 ]; then
  echo -e "  ${GREEN}PASS${NC} [post 正常系] exit ${POST_EXIT}"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [post 正常系] 予期しない exit ${POST_EXIT}"
  FAIL=$((FAIL + 1))
fi

# テスト 7: .env 書込検出ロジックの存在確認
echo ""
echo "--- Test 7: .env 書込検出ロジック確認 ---"
if grep -q '\.env\|secrets/' "${POST_TOOL}"; then
  echo -e "  ${GREEN}PASS${NC} [.env 検出] post_tool_use に .env/secrets/ 検出コードあり"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [.env 検出] post_tool_use に検出コードが見つかりません"
  FAIL=$((FAIL + 1))
fi

# テスト 8: ログファイルが作成されるか確認
echo ""
echo "--- Test 8: ログファイル生成確認 ---"
LOG_FILE="${REPO_ROOT}/.claude/logs/hooks.log"
CLAUDE_TOOL_NAME="TestTool" bash "${PREFLIGHT}" >/dev/null 2>&1 || true
if [ -f "${LOG_FILE}" ]; then
  echo -e "  ${GREEN}PASS${NC} [ログ生成] ${LOG_FILE} が存在します"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [ログ生成] ${LOG_FILE} が作成されませんでした"
  FAIL=$((FAIL + 1))
fi

# テスト 9: settings.json が不変か確認 (hook 実行後も 32 bytes のまま)
echo ""
echo "--- Test 9: settings.json 不変確認 ---"
SETTINGS_SIZE="$(wc -c < "${REPO_ROOT}/.claude/settings.json" | tr -d ' ')"
if [ "${SETTINGS_SIZE}" -eq 32 ]; then
  echo -e "  ${GREEN}PASS${NC} [settings.json 不変] ${SETTINGS_SIZE} bytes (期待値: 32)"
  PASS=$((PASS + 1))
else
  echo -e "  ${RED}FAIL${NC} [settings.json 不変] ${SETTINGS_SIZE} bytes (期待値: 32)"
  FAIL=$((FAIL + 1))
fi

# =============================================================================
# サマリー
# =============================================================================

echo ""
echo "======================================"
echo " テスト結果サマリー"
echo "======================================"
TOTAL=$((PASS + FAIL))
echo "  合計: ${TOTAL} テスト"
echo -e "  ${GREEN}PASS: ${PASS}${NC}"
if [ "${FAIL}" -gt 0 ]; then
  echo -e "  ${RED}FAIL: ${FAIL}${NC}"
else
  echo -e "  ${GREEN}FAIL: 0${NC}"
fi
echo ""

if [ "${FAIL}" -eq 0 ]; then
  echo -e "  ${GREEN}✅ 全テスト PASS — proposed hook を有効化する準備ができています${NC}"
  echo "  次のステップ: README.md の「有効化手順」を参照"
  echo "======================================"
  exit 0
else
  echo -e "  ${RED}❌ ${FAIL} テスト FAIL — 有効化前に修正が必要です${NC}"
  echo "======================================"
  exit 1
fi
